{
  "name": "@local/dsh-ui-zoom",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Масштаб интерфейса Harness: Ctrl+= / Ctrl+- / Ctrl+0, нумпад и Ctrl+колесо.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
